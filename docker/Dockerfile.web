# PermitGraph web frontend image: multi-stage build -> static files served by nginx.
#
# The API base URL is NOT baked in at build time; nginx proxies /api, /health, /ready
# to the `api` service (see docker/nginx.conf + docker-compose.yml), mirroring the
# dev-time Vite proxy setup in apps/web/vite.config.ts so the same relative-URL
# frontend code works unmodified in both environments.
FROM node:22-slim AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
