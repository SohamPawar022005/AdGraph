# PermitGraph Environment Configuration
DATABASE_URL=sqlite:///./permitgraph_dev.db
PERMITGRAPH_SECRET_KEY=dev-only-insecure-secret-change-me

# LLM Regulatory Co-Pilot Configuration
# 1. Primary: Google Gemini API (Provide your key here)
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Fallback: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
